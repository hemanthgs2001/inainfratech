# EmailJS (SMTP relay) credentials for Contact Us and Feedback forms.
# Copy this file to .env and fill in your provisioned EmailJS values,
# then wire them into ContactForm.jsx and FeedbackForm.jsx.
VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_CONTACT_TEMPLATE_ID=your_contact_template_id
VITE_EMAILJS_FEEDBACK_TEMPLATE_ID=your_feedback_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key
